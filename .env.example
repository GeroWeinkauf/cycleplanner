# ──────────────────────────────────────────────
# CyclePlanner Umgebungsvariablen
# Kopiere diese Datei nach .env und passe sie an.
# ──────────────────────────────────────────────

# ── Host-Adresse (nach außen veröffentlichte Ports) ──
# Immer 127.0.0.1 für rein lokalen Betrieb.
# Auf 0.0.0.0 setzen für Erreichbarkeit im LAN oder Server-Betrieb.
HOST_BIND=127.0.0.1

# ── Ports ──
# Externer Port für den Caddy-Webserver (HTTP)
CADDY_PORT=8080
# Externer Port für den Caddy-Webserver (HTTPS, nur bei Server-Betrieb)
CADDY_PORT_HTTPS=8443
# API-Port (intern, nur im Compose-Netz)
API_PORT=3000
# Valhalla-Port (intern, NIE nach außen)
VALHALLA_PORT=8002

# ── Valhalla ──
# Auf True setzen für Neuaufbau des Graphen (Profil "build")
VALHALLA_BUILD_ELEVATION=False
# Anzahl Threads für Valhalla
VALHALLA_SERVER_THREADS=4

# ── Betriebsmodus ──
# local: Nur localhost, kein TLS
# server: TLS aktiviert, Zugangsschutz
DEPLOY_MODE=local

# ── Server-Modus Einstellungen (nur bei DEPLOY_MODE=server) ──
# Domain/IP für TLS-Zertifikat (Let's Encrypt benötigt echte Domain)
CADDY_HOSTNAME=localhost
# TLS-Modus: off (kein TLS), tls internal (selbstsigniert), tls letsencrypt (Produktion)
CADDY_TLS=off
# Zugangsdaten für Basic Auth (bcrypt-Hash mit caddy hash-password erzeugen)
# Format: "benutzername $2a$14$hash..."
CYCLEPLANNER_CREDENTIALS=
# HTTPS-Port im Server-Modus
CADDY_PORT_HTTPS=8443

# ── KI-Tourenplanung (P6-1) ──
# Verwendet DeepSeek als Default (OpenAI-kompatibles Format).
# Für andere Anbieter URL und Model anpassen.
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=sk-dein-deepseek-key
LLM_MODEL=deepseek-chat

# ── Google Maps Places API (P4-2) ──
# Get a key at: https://console.cloud.google.com/apis/credentials
# Enables rich place details (ratings, opening hours) on POI click
# For security: instead of pasting the key here, put it in a file at:
#   auth/google-api-key.txt (gitignored, NEVER committed)
# Then set this to the file path:
GOOGLE_API_KEY_FILE=auth/google-api-key.txt
# Or set the key directly (less secure):
GOOGLE_MAPS_API_KEY=
# Usage tracking file (committed to git for tracking across PCs):
GOOGLE_USAGE_FILE=data/usage/google-places-usage.json
